DB_NAME=locatech
DB_USER=locatech
DB_PASSWORD=locatech123
DB_HOST=db
DB_PORT=5432

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=backend.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Optional: set these locally when using the corresponding features.
# GEMINI_API_KEY=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Connexion « Continuer avec Google » (espace client)
# ID client OAuth « Application Web », origine autorisée : http://localhost:4200
# Côté Angular en dev, le mettre aussi dans frontend/src/runtime-config.local.json
GOOGLE_CLIENT_ID=

# Paiement par carte : passerelle locale (ecommerce_monitoring/docker-compose.gateway.yml, simulateur)
#   GATEWAY_PROVIDER=simulator GATEWAY_API_KEY=<clé> GATEWAY_WEBHOOK_SECRET=<secret> \
#   GATEWAY_MERCHANT_WEBHOOK_URL=http://host.docker.internal:8045/paiements/webhook/ \
#   docker compose -f docker-compose.gateway.yml up -d
PAYMENT_GATEWAY_URL=http://host.docker.internal:8011
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PUBLIC_FRONTEND_URL=http://localhost:4200

# Backend-to-n8n address inside the Docker network
N8N_INTERNAL_URL=http://n8n:5678

# n8n URLs used by your browser and generated webhooks
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
TZ=UTC
