# Modèle du .env de PRODUCTION (/srv/Locatech/.env sur le serveur).
# Copier en .env puis remplir les valeurs. Ne jamais versionner le vrai .env.

# Clé Django : signe les jetons JWT. Obligatoire avec backend.settings.prod.
# Générer (hex, 64 caractères) : openssl rand -hex 32
#   ou : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DB_NAME=locatech
DB_USER=locatech
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Port local du serveur pour pgAdmin via tunnel SSH (127.0.0.1 uniquement). Doit être libre :
#   sudo ss -ltn | grep ':<port>'   (aucune sortie = libre)
DB_TUNNEL_PORT=5433

DJANGO_ALLOWED_HOSTS=api.locatech-mada.rakotoarinosy.com
DJANGO_SETTINGS_MODULE=backend.settings.prod

CORS_ALLOWED_ORIGINS=https://admin.locatech-mada.online,https://locatech-mada.online
CSRF_TRUSTED_ORIGINS=https://admin.locatech-mada.online,https://locatech-mada.online

GEMINI_API_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ─────────────────────────────────────────
# Connexion « Continuer avec Google » (espace client)
# ID client OAuth « Application Web » : Google Cloud Console > API et services > Identifiants.
# Origines JavaScript autorisées : https://locatech-mada.online
# Lu par Django (vérification du jeton) ET par le conteneur frontend (runtime-config.json).
# Vide = bouton Google désactivé.
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────
# Paiement par carte : passerelle ecommerce_monitoring (la même que BazarStore)
# LocaTech doit être déclaré dans GATEWAY_MERCHANTS côté passerelle avec la MÊME clé et le MÊME secret.
# Générer chacun : openssl rand -hex 32. Vides = paiement par carte désactivé (espèces seulement).
PAYMENT_GATEWAY_URL=https://ecommerce-api.rakotoarinosy.com
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Site public : pages de retour après paiement et liens de paiement envoyés par email
PUBLIC_FRONTEND_URL=https://locatech-mada.online

# ─────────────────────────────────────────
# n8n
N8N_INTERNAL_URL=http://n8n:5678
N8N_HOST=automation.locatech-mada.rakotoarinosy.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://automation.locatech-mada.rakotoarinosy.com/
GENERIC_TIMEZONE=Indian/Antananarivo
TZ=Indian/Antananarivo
